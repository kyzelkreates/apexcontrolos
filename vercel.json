{
  "buildCommand": "cd apex-command-center && npm install && npm run build",
  "outputDirectory": "apex-command-center/.next",
  "installCommand": "cd apex-command-center && npm install",
  "framework": "nextjs",
  "regions": ["lhr1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
